[TEMPLATE]
# Supabase — your project's URL + anon (publishable) key
VITE_SUPABASE_URL=https://your-project.supabase.co
# Either name works — same key value
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# NewsAPI.org key — powers the "Live wire" section on the Blog tab.
# Used only by the server-side proxy (server/news-proxy.mjs), never
# shipped to the browser. Get one free at newsapi.org.
VITE_NEWS_API_KEY=your-newsapi-org-key

# Static hosting (Netlify/Vercel/Cloudflare Pages): set this to your
# deployed news proxy so /api/news works in production, e.g.
#   VITE_API_BASE=https://festivity-proxy.onrender.com
# Leave it empty if you serve the whole site with `npm run serve`
# (the proxy then lives at the same origin).
VITE_API_BASE=

# ------------------------------------------------------------------
# Hosting checklist
# ------------------------------------------------------------------
# 1. Set the three VITE_* vars above in your host's dashboard
#    (.env is gitignored — never commit secrets).
# 2. In Supabase → Authentication → URL Configuration, set Site URL
#    and add your domain to the Redirect URLs (email confirmation +
#    password-reset links point there).
# 3. Storage buckets `avatars` + `hype` and all tables are created by
#    running supabase/schema.sql (idempotent — safe to re-run).
