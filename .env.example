# Appwrite — backend (project "House", fra.cloud.appwrite.io)
# Endpoint + project ID are public-safe; the client SDK uses them directly.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_PROJECT_NAME=House

# Live site — auth emails (verification / password reset) always link
# back here, even when the request came from localhost.
VITE_APP_URL=https://hypez.netlify.app

# NewsAPI.org key — powers the "Live wire" section on the Blog tab.
# Used only by the server-side proxy (server/news-proxy.mjs), never
# shipped to the browser. Get one free at newsapi.org.
VITE_NEWS_API_KEY=your-newsapi-org-key

# Static hosting (Netlify/Vercel/Cloudflare Pages): set this to your
# deployed news proxy so /api/news works in production, e.g.
#   VITE_API_BASE=https://festivity-proxy.onrender.com
# Leave it empty if you serve the whole site with `npm run serve`
# (the proxy then lives at the same origin).
VITE_API_BASE=

# ------------------------------------------------------------------
# Hosting checklist
# ------------------------------------------------------------------
# 1. Set the VITE_* vars above in your host's dashboard
#    (.env is gitignored — never commit secrets).
# 2. Storage bucket `avatars` must exist in Appwrite (Console → Storage
#    → Create bucket: "avatars", public read). Auth emails are sent by
#    Appwrite itself — no SMTP setup needed.
# 3. Phase 2 (coming): Appwrite databases + collections replace the
#    local-first storage for parties, reviews, tickets and social.
