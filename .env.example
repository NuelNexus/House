[TEMPLATE]
# Supabase — your project's URL + publishable (anon) key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# NewsAPI.org key — powers the "Live wire" section on the Blog tab.
# Used only by the server-side proxy (server/news-proxy.mjs), never
# shipped to the browser. Get one free at newsapi.org.
VITE_NEWS_API_KEY=your-newsapi-org-key

# Static hosting (Netlify/Vercel/Cloudflare Pages): set this to your
# deployed news proxy so /api/news works in production, e.g.
#   VITE_API_BASE=https://festivity-proxy.onrender.com
# Leave it empty if you serve the whole site with `npm run serve`
# (the proxy then lives at the same origin).
VITE_API_BASE=

# ------------------------------------------------------------------
# Hosting checklist
# ------------------------------------------------------------------
# 1. Set the VITE_* vars above in your host's dashboard
#    (.env is gitignored — never commit secrets).
# 2. Supabase → Authentication → URL Configuration: set Site URL and
#    add your domain(s) to the Redirect URLs (local http://localhost:5173
#    for dev + your live domain). Google sign-in bounces back to these.
# 3. Supabase → Authentication → Sign In / Up → Email: turn OFF
#    "Confirm email" so new accounts are active immediately.
# 4. Supabase → Authentication → Providers: enable Google and paste the
#    OAuth Client ID + Secret from Google Cloud Console.
# 5. Storage buckets `avatars` + `hype` and all tables are created by
#    running supabase/schema.sql (idempotent — safe to re-run).
